#!/usr/bin/env bash
#===============================================================================
# cws-launch — guardian wrapper around the Claude Desktop launcher
#
# Runs as the session user, in front of whichever launcher is
# installed. Before every launch it rotates copy-if-changed backups of
# the config files whose only source of truth is the file itself —
# the upstream app can serialize an empty state over them after a
# failed cold-start read (anthropics/claude-code#32345/#59640/#63651),
# and a pre-launch copy is the recovery path.
#
# Idea credit: aaddrick/claude-desktop-debian's hardened launcher
# (v3.0.0). This is a from-scratch implementation for Coworkstation:
# launcher-side only, the app bytes are never touched, and it works
# in front of the official package too.
#
# Backups land in ~/.cache/coworkstation/config-backups/, newest
# first, keeping the last 5 changed copies per file.
#===============================================================================

backup_root="${CWS_BACKUP_ROOT:-$HOME/.cache/coworkstation/config-backups}"
# Extra per-device sessions redirect XDG_CONFIG_HOME (see lib/session.sh),
# so the guardian must act on the session's own config home, not always
# the primary's ~/.config/Claude.
claude_config="${CWS_CLAUDE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/Claude}"
keep=5

# Rotate one file into $backup_root, copy-if-changed, keep $keep.
# $1 = absolute path of the live file.
rotate_backup() {
	local src="$1"
	[[ -f $src ]] || return 0
	local rel="${src#"$claude_config"/}"
	local dir="$backup_root/${rel//\//_}"
	mkdir -p "$dir" || return 0

	# Backup filenames are sortable UTC stamps (ns precision so two
	# launches in the same second still get distinct copies), so
	# lexicographic sort IS newest-last.
	local newest
	newest=$(find "$dir" -maxdepth 1 -type f -printf '%f\n' \
		2> /dev/null | sort | tail -1)
	if [[ -n $newest ]] && cmp -s "$src" "$dir/$newest"; then
		return 0
	fi
	cp -p "$src" "$dir/$(date -u +%Y%m%dT%H%M%S.%N)" 2> /dev/null \
		|| return 0

	local stale
	while IFS= read -r stale; do
		rm -f "$dir/$stale"
	done < <(find "$dir" -maxdepth 1 -type f -printf '%f\n' \
		2> /dev/null | sort -r | tail -n +"$((keep + 1))")
}

# The files whose loss is durable: the MCP/trusted-folders config and
# the per-account Cowork stores (path varies per account, so glob).
guard_configs() {
	rotate_backup "$claude_config/claude_desktop_config.json"
	local f
	while IFS= read -r f; do
		rotate_backup "$f"
	done < <(find "$claude_config" -maxdepth 4 \
		\( -name 'spaces.json' \
		-o -name 'remote-session-spaces.json' \
		-o -name 'scheduled-tasks.json' \) 2> /dev/null)
}

# Clear a stale Chromium/Electron singleton left by an unclean shutdown.
# Electron records the running instance in SingletonLock (a "host-pid"
# symlink) and listens on SingletonSocket (a unix socket under /tmp). A
# crash leaves all three behind; after a reboot /tmp is wiped AND the
# recorded pid is often reused by an unrelated process (e.g. the primary
# session's Claude), so Electron believes the profile is already owned,
# tries to hand off to the vanished socket, and hangs with a blank
# window. A dangling socket target proves no live instance owns the
# profile — a real owner's socket exists — so it is safe to clear the
# trio and let this launch acquire the lock cleanly.
clear_stale_singleton() {
	local sock="$claude_config/SingletonSocket"
	# -L: the symlink is present; ! -e: its target is gone (dangling).
	if [[ -L $sock && ! -e $sock ]]; then
		rm -f "$claude_config/SingletonLock" \
			"$claude_config/SingletonSocket" \
			"$claude_config/SingletonCookie"
	fi
}

# Resolve the real launcher: official name first, community second.
find_launcher() {
	if command -v claude-desktop > /dev/null 2>&1; then
		printf 'claude-desktop'
	elif command -v claude-desktop-unofficial > /dev/null 2>&1; then
		printf 'claude-desktop-unofficial'
	else
		return 1
	fi
}

# Optional HiDPI scaling for the kiosk, via an EXPLICIT CWS_DEVICE_SCALE
# env var only. kasmVNC's remote-resize sizes the X framebuffer to the
# client's *CSS* viewport (verified: server framebuffer ==
# browser innerWidth/innerHeight, DPR-unaware), so Claude already renders
# its mobile layout at a phone-width viewport. Applying
# --force-device-scale-factor=DPR on top of a CSS-px framebuffer would
# *shrink* the logical viewport (e.g. 414 -> 138px) and BREAK the layout —
# it only helps once the framebuffer is device-px, which is future work.
# So this is a deliberate, manual knob; the login shim's captured
# devicePixelRatio is NOT auto-applied. Unset -> Chromium's default.
device_scale_flag() {
	local s="${CWS_DEVICE_SCALE:-}"
	# accept a positive decimal (e.g. 2 or 1.5); reject 0 and junk
	if [[ $s =~ ^[0-9]+(\.[0-9]+)?$ && $s != 0 && $s != 0.0 ]]; then
		printf -- '--force-device-scale-factor=%s' "$s"
	fi
}

# Extra per-device sessions run on their own private D-Bus (see
# lib/session.sh's dbus-run-session), whose xdg-desktop-portal exposes a
# secret-service proxy with no working backend. Electron's default
# gnome_libsecret probe then blocks at startup and the window never
# paints. Force Chromium's plaintext 'basic' store so it never calls the
# secret service. These sessions already cannot persist an encrypted
# sign-in — the keyring is unavailable there — so this only removes the
# hang. The primary session is left on the default: its shared user bus
# has a responsive keyring.
main() {
	guard_configs
	clear_stale_singleton
	local launcher
	if ! launcher=$(find_launcher); then
		printf '[cws-launch] ERROR: no Claude Desktop launcher found\n' >&2
		return 127
	fi
	local -a extra=()
	local scale
	scale=$(device_scale_flag)
	[[ -n $scale ]] && extra+=("$scale")
	# Always use the plaintext 'basic' store. Electron's safeStorage does
	# NOT use the OS keyring on the current Claude Desktop build (verified:
	# isEncryptionAvailable never true even with a correct, unlocked
	# default keyring — see docs/plans/2026-07-06-session-keyring-design.md
	# and JongoDB/coworkstation#12), so the keyring bought nothing and its
	# create/unlock prompt was pure friction. --password-store=basic also
	# means no secret-service probe, so no session (primary, member, or
	# extra :50+) can hang on the keyring. Restore the keyring path (git
	# history has prepare_keyring) if a Desktop build's safeStorage starts
	# using libsecret.
	exec "$launcher" --password-store=basic "${extra[@]}" "$@"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
